generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Managed by @shopify/shopify-app-session-storage-prisma. Do not rename fields.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                       String          @id @default(cuid())
  shopDomain               String          @unique
  name                     String?
  installedAt              DateTime        @default(now())
  uninstalledAt            DateTime?
  setupDismissedAt         DateTime?
  storefrontStepSkippedAt  DateTime?
  /// none | solo | group (from the active Shopify subscription, cached)
  plan                     String          @default("none")
  planCheckedAt            DateTime?
  ianaTimezone             String?
  currencyCode             String?
  /// Online Store publication id, cached for publishing products
  onlineStorePublicationId String?
  /// Stable merchant preferences the assistant may reuse (brand voice, default vendor, ...)
  memory                   Json            @default("{}")
  settings                 ShopSettings?
  group                    StoreGroup?
  episodes                 Episode[]
  mediaAssets              MediaAsset[]
  merchantUsers            MerchantUser[]
  linkCodes                LinkCode[]
  waMessages               WaMessage[]
  auditEvents              AuditEvent[]
  pendingActions           PendingAction[]
  llmUsage                 LlmUsage[]
}

model ShopSettings {
  shopId                String    @id
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// auto | en | hi
  language              String    @default("auto")
  /// standard: approve publishing, prices, shipping, discounts, storefront, deletions
  /// strict:   also approve drafts and stock changes
  approvalMode          String    @default("standard")
  /// off | daily | weekly (Group plan feature)
  summaryFrequency      String    @default("weekly")
  /// 1 = Monday ... 7 = Sunday, for weekly summaries
  weeklySummaryDay      Int       @default(1)
  /// Local hour (shop timezone) to send summaries and digests
  summaryHour           Int       @default(9)
  /// Group plan feature
  checkoutDigestEnabled Boolean   @default(true)
  /// dm (owner's chat) | group (the store team group, when it exists)
  updatesDestination    String    @default("group")
  lastSummaryAt         DateTime?
  lastDigestAt          DateTime?
  updatedAt             DateTime  @updatedAt
}

/// A WhatsApp number allowed to manage a shop.
model MerchantUser {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// E.164 digits without "+", as WhatsApp sends it
  waId          String
  /// WhatsApp business-scoped user id (BSUID), when known
  userId        String?
  displayName   String?
  /// owner | staff
  role          String    @default("owner")
  linkedAt      DateTime  @default(now())
  revokedAt     DateTime?
  lastInboundAt DateTime?

  @@unique([shopId, waId])
  @@index([waId])
}

model LinkCode {
  code       String    @id
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  usedByWaId String?

  @@index([shopId])
}

model WaMessage {
  id          String   @id @default(cuid())
  /// Meta message id; unique so webhook retries are ignored
  waMessageId String   @unique
  /// in | out
  direction   String
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  waId        String
  groupId     String?
  /// Set when the assistant has taken this inbound message into a turn
  processedAt DateTime?
  type        String
  body        String?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([groupId, processedAt])
  @@index([waId, processedAt])
}

/// Append-only record of every change the assistant made or attempted.
model AuditEvent {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// agent | merchant | system
  actor           String
  waId            String?
  tool            String
  summary         String
  /// done | failed | undone
  status          String    @default("done")
  /// GraphQL operations that reverse this change: [{ query, variables }]
  undoOps         Json?
  undoneAt        DateTime?
  pendingActionId String?
  details         Json?
  createdAt       DateTime  @default(now())

  @@index([shopId, createdAt])
}

/// A high-impact change frozen until the merchant approves it.
model PendingAction {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tool            String
  summary         String
  diffText        String
  /// Exact operations to run on approval: [{ query, variables }]
  ops             Json
  /// Operations that reverse the change, recorded on the audit event after it runs
  undoOps         Json?
  /// pending | approved | rejected | expired | failed
  status          String    @default("pending")
  /// Short code merchants type in groups ("YES 4821"), where buttons are not available
  approvalCode    String?
  /// Conversation the request was made in: "dm:<waId>" or "group:<groupId>"
  conversationKey String?
  /// member | owner: who may approve
  minRole         String    @default("member")
  requestedByWaId String?
  decidedBy       String?
  /// whatsapp | admin
  decidedVia      String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([shopId, status])
}

model LlmUsage {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  episodeId        String?
  purpose          String
  model            String
  inputTokens      Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int
  costUsd          Decimal  @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  @@index([shopId, createdAt])
}

/// The store team WhatsApp group (Group plan). One per shop.
model StoreGroup {
  id            String             @id @default(cuid())
  shopId        String             @unique
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Meta group id; null until the group_create webhook arrives
  groupId       String?            @unique
  requestId     String?
  subject       String
  inviteLink    String?
  /// creating | active | failed | deleted
  status        String             @default("creating")
  error         String?
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  participants  GroupParticipant[]
}

model GroupParticipant {
  id           String     @id @default(cuid())
  storeGroupId String
  storeGroup   StoreGroup @relation(fields: [storeGroupId], references: [id], onDelete: Cascade)
  waId         String?
  userId       String?
  name         String?
  joinedAt     DateTime   @default(now())
  leftAt       DateTime?

  @@index([storeGroupId])
}

/// One task-sized conversation with the assistant. Messages are stored in provider-neutral form.
model Episode {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversationKey String
  /// open | closed
  status          String   @default("open")
  /// agent | escalation
  route           String   @default("agent")
  messages        Json     @default("[]")
  summary         String?
  escalations     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shopId, conversationKey, status])
}

/// Inbound photos kept briefly for product creation (deleted after 7 days).
model MediaAsset {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversationKey String
  waMediaId       String?
  mimeType        String
  caption         String?
  data            Bytes
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([shopId, conversationKey, createdAt])
}

/// Background jobs. Jobs with the same conversationKey run one at a time, in order.
model Job {
  id              String    @id @default(cuid())
  kind            String
  conversationKey String?
  payload         Json
  /// queued | running | done | failed
  status          String    @default("queued")
  runAt           DateTime  @default(now())
  attempts        Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, runAt])
  @@index([conversationKey, status])
}
