# Copy to .env for local development. `shopify app dev` supplies the SHOPIFY_* values itself.

# Postgres, e.g. a local container or a Railway database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storemate"

# Filled in by the Shopify CLI during `shopify app dev`; set them yourself in production
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_publications,write_publications,read_inventory,write_inventory,read_locations,read_orders,read_themes

# App handle from the Partner Dashboard (Managed Pricing link) and optional banner extension uid
SHOPIFY_APP_HANDLE=storemate
SHOPIFY_BANNER_EXTENSION_UID=
SUPPORT_EMAIL=support@example.com

# Meta WhatsApp Cloud API. Leave blank to run in mock mode (messages are logged, not sent).
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0

# Approved WhatsApp templates for messages outside the 24-hour window (optional)
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_SUMMARY=
WHATSAPP_TEMPLATE_CHECKOUT_DIGEST=
WHATSAPP_TEMPLATE_GROUP_INVITE=

# LLM providers. Switch models per job with "provider:model" (see docs/11-groups-plans-and-llms.md).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_AGENT=anthropic:claude-haiku-5-5
LLM_ESCALATION=anthropic:claude-sonnet-5-5
LLM_LISTING=anthropic:claude-haiku-5-5
LLM_SUMMARY=anthropic:claude-haiku-5-5
LLM_FALLBACK=
OPENAI_REASONING_EFFORT=
LLM_PRICES_JSON=

# Plans (billing amounts themselves are set in the Partner Dashboard)
PLAN_SOLO_PRICE_USD=5.99
PLAN_GROUP_PRICE_USD=9.99
PLAN_SOLO_LLM_BUDGET_USD=2.5
PLAN_GROUP_LLM_BUDGET_USD=4
# Development only: force a plan, use the in-memory fake store
PLAN_OVERRIDE=
FAKE_SHOPIFY_STORE=

# Background worker (runs inside the web process)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
