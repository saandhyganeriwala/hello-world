# Copy to .env for local development (never commit .env).
# In production, set these in your host's environment settings (e.g. Railway → Variables).

# --- Required in production ---
NODE_ENV=production
# Postgres connection string. Leave unset locally to use an embedded database in .data/.
DATABASE_URL=postgres://user:password@host:5432/dbname
# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Effort for typed messages (low = fastest) and for screenshots/imports.
CLAUDE_EFFORT_CHAT=low
CLAUDE_EFFORT_HEAVY=medium
# Server-side refusal fallback (beta). On by default.
CLAUDE_FALLBACKS=true

# --- Login ---
# "email" (code by email via Resend) or "whatsapp" (code via Interakt).
LOGIN_METHOD=email

# --- Email OTP via Brevo (brevo.com) — free 300 emails/day ---
BREVO_API_KEY=
# EMAIL_PROVIDER=brevo   # or resend; picks automatically when only one key is set

# --- Email OTP via Resend (resend.com) ---
RESEND_API_KEY=
# Must use a domain verified with your email provider (Brevo or Resend).
EMAIL_FROM=CRUD.chat <login@crud.chat>

# --- WhatsApp OTP via Interakt (only when LOGIN_METHOD=whatsapp) ---
INTERAKT_API_KEY=
# Name of your approved WhatsApp "Authentication" template, exactly as in Interakt.
INTERAKT_OTP_TEMPLATE=
INTERAKT_TEMPLATE_LANG=en
# true if the template has a "Copy code" button (Authentication templates usually do).
INTERAKT_OTP_BUTTON=true
# INTERAKT_BASE_URL=https://api.interakt.ai

# Show the login code on screen instead of sending it.
# Useful to test a deployment before email/WhatsApp is set up. NEVER leave on for real users.
OTP_DEV_MODE=false

# Country assumed when someone types a phone number without +code (WhatsApp mode).
DEFAULT_COUNTRY=IN
# PORT=3000

# Mobile apps (see mobile/README.md)
# REVIEW_LOGIN=review@crud.chat:246810   # store reviewers log in with this fixed code (no email sent)
# In-app purchases (mobile/README.md → In-app purchases)
# IAP_PRODUCT_ID=chat.crud.pro.monthly
# APPLE_APP_ID=                         # numeric Apple ID of the app
# GOOGLE_PLAY_SERVICE_ACCOUNT=           # service account JSON key, one line
# GOOGLE_RTDN_TOKEN=                     # secret in the Pub/Sub push URL
# ANDROID_CERT_SHA256=                    # Play app-signing SHA-256, for invite links that open the Android app
# APPLE_TEAM_ID=                          # for invite links that open the iOS app

# Who can open the analytics dashboard at /admin (comma-separated login emails)
ADMIN_EMAILS=

# --- Plans & usage (every Claude call is priced from its tokens and charged to the workspace) ---
USD_INR=88
FREE_ACTIONS=10             # free AI actions per person
FREE_MEMBERS=3
PRO_PRICE_INR=499           # a month, India (Razorpay subscription, renews automatically)
PRO_PRICE_USD=6             # a month, everywhere else
PRO_MEMBERS=10
PRO_MONTHLY_AI_INR=225      # fair-usage AI budget a month (≈ 500 actions)
PRO_GRACE_DAYS=3            # Pro stays on this long past a renewal date while a failed charge is retried
ACTION_INR=0.45             # typical cost of one action, used for "≈ N actions"

# --- Razorpay (Dashboard → Account & Settings → API Keys; Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: plans made in the dashboard (otherwise created automatically on first checkout)
# RAZORPAY_PLAN_ID_INR=
# RAZORPAY_PLAN_ID_USD=
# true once International Payments (USD) is enabled on your Razorpay account
RAZORPAY_INTERNATIONAL=false

# --- Voice transcription (better than the browser's own; falls back to it when unset) ---
# OpenAI gpt-4o-mini-transcribe (~$0.003/min) — or Sarvam Saaras v3 for Hinglish / Indian languages (~₹30/hour).
OPENAI_API_KEY=
SARVAM_API_KEY=
# TRANSCRIBE_PROVIDER=openai   # or sarvam; picks automatically when only one key is set
# SARVAM_MODE=codemix          # transcribe | translate | translit | codemix
