# Copy to .env for local development (never commit .env).
# In production, set these in your host's environment settings (e.g. Railway → Variables).

# --- Required in production ---
NODE_ENV=production
# Postgres connection string. Leave unset locally to use an embedded database in .data/.
DATABASE_URL=postgres://user:password@host:5432/dbname
# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Effort for typed messages (low = fastest) and for screenshots/imports.
CLAUDE_EFFORT_CHAT=low
CLAUDE_EFFORT_HEAVY=medium
# Server-side refusal fallback (beta). On by default.
CLAUDE_FALLBACKS=true

# --- Login ---
# "email" (code by email via Resend) or "whatsapp" (code via Interakt).
LOGIN_METHOD=email

# --- Email OTP via Resend (resend.com) ---
RESEND_API_KEY=
# Must use a domain you've verified in Resend.
EMAIL_FROM=CRUD.chat <login@crud.chat>

# --- WhatsApp OTP via Interakt (only when LOGIN_METHOD=whatsapp) ---
INTERAKT_API_KEY=
# Name of your approved WhatsApp "Authentication" template, exactly as in Interakt.
INTERAKT_OTP_TEMPLATE=
INTERAKT_TEMPLATE_LANG=en
# true if the template has a "Copy code" button (Authentication templates usually do).
INTERAKT_OTP_BUTTON=true
# INTERAKT_BASE_URL=https://api.interakt.ai

# Show the login code on screen instead of sending it.
# Useful to test a deployment before email/WhatsApp is set up. NEVER leave on for real users.
OTP_DEV_MODE=false

# Country assumed when someone types a phone number without +code (WhatsApp mode).
DEFAULT_COUNTRY=IN
# PORT=3000
